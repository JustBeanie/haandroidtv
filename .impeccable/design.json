  "narrative": {
    "northStar": "Immediate household controls from a TV remote",
    "overview": "Native Android TV Material surfaces make household controls legible from a sofa and predictable with a directional pad. Dark navy grounds the interface; restrained tonal layers separate controls, cyan identifies focus, and amber identifies active device values.\n\nThe system favors familiar tabs, pill buttons, rounded cards, and scrollable dialogs. Android system typography is intentional. This is a native Compose app, with no website font or browser layout requirement.",
    "keyCharacteristics": [
      "Clear remote focus, persistent context, and TV-safe edges.",
      "Tonal surfaces with semantic color and actual device state.",
      "Adaptive density that preserves readable text and reachable actions."
    ],
    "rules": [
      {
        "name": "The Focus Is Separate Rule",
        "body": "Focus identifies the current remote target; amber identifies device activity. A focused active card retains its amber value while receiving the cyan focus outline.",
        "section": "colors"
      },
      {
        "name": "The Truthful State Rule",
        "body": "Connection and command states are written in text. Cached values read as last known; pending and failed actions keep their own feedback instead of implying success.",
        "section": "colors"
      },
      {
        "name": "The Fit Before Density Rule",
        "body": "Preserve safe edges, font scaling, and reachable controls; reduce visible rows and use scrolling when the viewport cannot hold the full composition.",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** use native TV Material controls and the Android system typeface.",
      "**Do** preserve TV-safe margins, font scaling, and visible remote focus.",
      "**Do** distinguish device activity, remote focus, connection state, and command feedback.",
      "**Do** retain a focused action hint in compact Favorites layouts.",
      "**Do** reuse semantic vector icons and the shared button, field, row, and dialog components."
    ],
    "donts": [
      "**Don't** use cached states as evidence that controls are live.",
      "**Don't** force two card rows when the available height cannot fit them.",
      "**Don't** remove the current remote target while a command is pending.",
      "**Don't** treat illustrative HTML previews or synthesized tonal ramps as native runtime tokens."
    ]
  }
}
